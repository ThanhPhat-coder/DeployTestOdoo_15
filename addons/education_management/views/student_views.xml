<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Tree view -->
        <record id="view_student_tree" model="ir.ui.view">
            <field name="name">education.student.tree</field>
            <field name="model">education.student</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                </tree>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_student_form" model="ir.ui.view">
            <field name="name">education.student.form</field>
            <field name="model">education.student</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_students" model="ir.actions.act_window">
            <field name="name">Students</field>
            <field name="res_model">education.student</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
