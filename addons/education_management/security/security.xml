<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Nhóm quyền -->
        <record id="group_education_user" model="res.groups">
            <field name="name">Education User</field>
        </record>

        <record id="group_education_manager" model="res.groups">
            <field name="name">Education Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_education_user'))]"/>
        </record>

        <!-- Quyền truy cập Student -->
        <record id="education_student_rule_user" model="ir.rule">
            <field name="name">Education Student: user can see their records</field>
            <field name="model_id" ref="model_education_student"/>
            <field name="groups" eval="[(4, ref('group_education_user'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

        <!-- ACL -->
        <record id="access_education_student" model="ir.model.access">
            <field name="name">education.student access</field>
            <field name="model_id" ref="model_education_student"/>
            <field name="group_id" ref="group_education_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

    </data>
</odoo>
